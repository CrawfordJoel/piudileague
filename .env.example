# Public site reads may use these two values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# NEVER expose this key in browser code or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Current Sleeper league. The sync script can walk backward using previous_league_id.
SLEEPER_CURRENT_LEAGUE_ID=1313002588936880128
